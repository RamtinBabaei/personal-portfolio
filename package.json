{
  "name": "ramtin-babaei-portfolio",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint app components lib db tests next.config.ts proxy.ts --ignore-pattern components/ui/**",
    "db:generate": "drizzle-kit generate",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write app components/*.tsx lib/*.ts lib/server db tests next.config.ts proxy.ts",
    "format:check": "prettier --check app components/*.tsx lib/*.ts lib/server db tests next.config.ts proxy.ts",
    "db:prisma:generate": "prisma generate",
    "db:prisma:migrate": "prisma migrate deploy",
    "build:next": "next build",
    "dev:next": "next dev",
    "start:next": "next start",
    "db:local:init": "node scripts/local-database.mjs init",
    "fonts:generate": "node scripts/generate-font-data.mjs",
    "db:local:upgrade": "node scripts/local-database.mjs upgrade",
    "setup:local": "node scripts/setup-local.mjs",
    "contact:verify": "node scripts/verify-contact.mjs",
    "test:integration": "node tests/integration/contact-worker.mjs && node tests/integration/local-email-transport.mjs && node tests/integration/local-migrations.mjs && node tests/integration/local-outbox.mjs",
    "contact:send-test": "node scripts/send-test-inquiry.mjs",
    "outbox:run": "node scripts/run-outbox.mjs",
    "db:remote:init": "node scripts/local-database.mjs init --remote",
    "db:remote:upgrade": "node scripts/local-database.mjs upgrade --remote"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "drizzle-orm": "0.45.2",
    "gsap": "^3.15.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "vitest": "^5.0.3",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
