!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.dev.vars*
!.dev.vars.example

# vercel
.vercel

# typescript
next-env.d.ts

# Maintained Vite plugin and worker sources.
!/build/
/build/*
!/build/connector-preview-plugin.mjs
!/build/connector-preview-worker.mjs
!/build/local-email-plugin.mjs
!/build/local-outbox-plugin.mjs
!/build/sites-vite-plugin.LICENSE
!/build/sites-vite-plugin.ts
!/build/sites-worker.ts

/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

# Generated incremental TypeScript state.
*.tsbuildinfo

# Generated portable production configuration.
/wrangler.production.json


